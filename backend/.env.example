# ============================================
# FoodScan AI - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ── Database Configuration ──────────────────
DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=foodscan_db
DB_PORT=3306

# ── API Keys ────────────────────────────────
# Groq API (for Llama 3 AI analysis)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenFoodFacts User Agent (required for API calls)
OPENFOODFACTS_USER_AGENT=FoodScanAI/1.0 (https://github.com/HugoSabater/FoodScan-AI)

# ── Server Configuration ────────────────────
PORT=3000
NODE_ENV=development

# ── CORS Configuration ──────────────────────
# Frontend URL (for CORS)
CORS_ORIGIN=http://localhost:4200

# ── Security ────────────────────────────────
# JWT Secret (generate a random string)
# Example: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_min_32_chars

# ── Production Notes ────────────────────────
# For production deployment:
# - Set NODE_ENV=production
# - Use strong DB_PASSWORD
# - Update CORS_ORIGIN to your frontend URL
# - Never expose GROQ_API_KEY in client-side code
