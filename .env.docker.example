# ============================================
# FoodScan AI - Docker Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ── Database Configuration ──────────────────
DB_ROOT_PASSWORD=
DB_NAME=foodscan_db
DB_USER=root
DB_PASSWORD=
DB_PORT=3306

# ── API Keys ────────────────────────────────
# Groq API (for Llama 3 AI analysis)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenFoodFacts User Agent (required for API calls)
OPENFOODFACTS_USER_AGENT=FoodScanAI/1.0 (https://github.com/HugoSabater/FoodScan-AI)

# ── Security ────────────────────────────────
# JWT Secret (generate a random string)
# Example: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_min_32_chars

# ── Server Ports ────────────────────────────
BACKEND_PORT=3000
FRONTEND_PORT=80

# ── CORS Configuration ──────────────────────
# Frontend URL (for CORS)
# For production, set to your actual domain
CORS_ORIGIN=http://localhost

# ── Production Notes ────────────────────────
# For production deployment:
# - Use strong passwords for DB_ROOT_PASSWORD and DB_PASSWORD
# - Update CORS_ORIGIN to your frontend domain (e.g., https://foodscan.example.com)
# - Never expose GROQ_API_KEY in client-side code
# - Consider using Docker secrets for sensitive data
# - Enable HTTPS with a reverse proxy (Nginx, Traefik, Caddy)
